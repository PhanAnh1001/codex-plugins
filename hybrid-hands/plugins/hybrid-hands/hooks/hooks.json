{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 10,
            "statusMessage": "Loading Hybrid Hands workflow",
            "additionalContextLimit": 16000
          }
        ]
      }
    ]
  }
}
